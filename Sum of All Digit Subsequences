////////////////////////////////                            Sum of All Digit Subsequences                              ////////////////////////////////







class Solution {
    public int subsequenceSum(String s) {
        long MOD = 1000000007L;
        long sum = 0;

        int n = s.length();

        for (int i = 0; i < n; i++) {
            sum = (sum + (s.charAt(i) - '0')) % MOD;
        }

        long power = 1;

        for (int i = 0; i < n - 1; i++) {
            power = (power * 2) % MOD;
        }

        return (int)((sum * power) % MOD);
    }
}

