/////////////////////////////////                           Generate Usernames                         //////////////////////////////////








import java.util.*;

class Solution {
    public ArrayList<String> generateUsernames(String[] arr) {
        HashSet<String> reserved = new HashSet<>();
        HashSet<String> used = new HashSet<>();
        HashMap<String, Integer> next = new HashMap<>();

       
        for (String s : arr) {
            reserved.add(s);
        }

        ArrayList<String> ans = new ArrayList<>();

        for (String s : arr) {

            if (!used.contains(s)) {
                ans.add(s);
                used.add(s);
            } else {
                int num = next.getOrDefault(s, 1);
                String candidate;

                while (true) {
                    candidate = s + num;

                    if (!reserved.contains(candidate)
                            && !used.contains(candidate)) {
                        break;
                    }

                    num++;
                }

                ans.add(candidate);
                used.add(candidate);
                next.put(s, num + 1);
            }
        }

        return ans;
    }
}

 
