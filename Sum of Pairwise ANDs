//////////////////////////                      Sum of Pairwise ANDs                     ///////////////////////////





class Solution {
    public long pairAndSum(int[] Arr) {
        long ans = 0;

       
        for (int bit = 0; bit < 31; bit++) {
            long count = 0;

           
            for (int num : Arr) {
                if ((num & (1 << bit)) != 0) {
                    count++;
                }
            }

           
            long pairs = count * (count - 1) / 2;

         
            ans += pairs * (1L << bit);
        }

        return ans;
    }
}
