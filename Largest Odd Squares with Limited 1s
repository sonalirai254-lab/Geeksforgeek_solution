////////////////                   Largest Odd Squares with Limited 1s                    /////////////////






import java.util.*;

class Solution {
    public static ArrayList<Integer> largestSquare(
            int[][] mat, int[][] queries, int k) {

        int n = mat.length;
        int m = mat[0].length;

        int[][] prefix = new int[n + 1][m + 1];

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                prefix[i + 1][j + 1] =
                        prefix[i][j + 1]
                        + prefix[i + 1][j]
                        - prefix[i][j]
                        + mat[i][j];
            }
        }

        ArrayList<Integer> ans = new ArrayList<>();

        for (int[] q : queries) {

            int row = q[0];
            int col = q[1];

            int maxRadius = Math.min(
                    Math.min(row, col),
                    Math.min(n - row - 1, m - col - 1)
            );

            if (mat[row][col] > k) {
                ans.add(-1);
                continue;
            }

            int low = 0;
            int high = maxRadius;
            int best = 0;

            while (low <= high) {

                int mid = low + (high - low) / 2;

                int r1 = row - mid;
                int c1 = col - mid;
                int r2 = row + mid;
                int c2 = col + mid;

                int ones =
                        prefix[r2 + 1][c2 + 1]
                        - prefix[r1][c2 + 1]
                        - prefix[r2 + 1][c1]
                        + prefix[r1][c1];

                if (ones <= k) {
                    best = mid;
                    low = mid + 1;
                } else {
                    high = mid - 1;
                }
            }

            ans.add(2 * best + 1);
        }

        return ans;
    }
}
