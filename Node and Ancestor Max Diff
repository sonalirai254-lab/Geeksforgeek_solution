/////////////////                    Node and Ancestor Max Diff                      /////////////////



class Solution {
    int maxDiff = Integer.MIN_VALUE;

    int maxDiff(Node root) {
        dfs(root);
        return maxDiff;
    }

    private int dfs(Node root) {
       
        if (root == null) {
            return Integer.MAX_VALUE;
        }

       
        if (root.left == null && root.right == null) {
            return root.data;
        }

        int leftMin = dfs(root.left);
        int rightMin = dfs(root.right);

        int minDescendant = Math.min(leftMin, rightMin);

       
        maxDiff = Math.max(maxDiff, root.data - minDescendant);

        return Math.min(root.data, minDescendant);
    }
}
