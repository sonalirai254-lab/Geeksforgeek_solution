/////////////                  Max Sum Subarray of Size at least K                      //////////////




class Solution {
    public int maxSumWithK(int[] arr, int k) {
        int n = arr.length;

        int[] maxEnding = new int[n];
        maxEnding[0] = arr[0];

        for (int i = 1; i < n; i++) {
            maxEnding[i] = Math.max(arr[i], maxEnding[i - 1] + arr[i]);
        }

        int windowSum = 0;
        for (int i = 0; i < k; i++) {
            windowSum += arr[i];
        }

        int ans = windowSum;

        for (int i = k; i < n; i++) {
            windowSum += arr[i] - arr[i - k];

            ans = Math.max(ans, windowSum);
            ans = Math.max(ans, windowSum + maxEnding[i - k]);
        }

        return ans;
    }
}
