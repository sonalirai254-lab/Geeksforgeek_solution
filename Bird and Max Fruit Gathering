////////////////////////////                           Bird and Max Fruit Gathering                                ///////////////////////////






import java.util.*;

class Solution {
    public int maxFruits(ArrayList<Integer> arr, int m) {
        int n = arr.size();

        if (m >= n) {
            int total = 0;

            for (int x : arr) {
                total += x;
            }

            return total;
        }

        int windowSum = 0;

        
        for (int i = 0; i < m; i++) {
            windowSum += arr.get(i);
        }

        int maxSum = windowSum;

        
        for (int i = 1; i < n; i++) {
           
            windowSum -= arr.get(i - 1);

           
            windowSum += arr.get((i + m - 1) % n);

            maxSum = Math.max(maxSum, windowSum);
        }

        return maxSum;
    }
}
