///////////////                     Subarrays with Sum in Range                     ///////////////




class Solution {

    public int countSubarray(int[] arr, int l, int r) {
        long ans = countAtMost(arr, r) - countAtMost(arr, l - 1);
        return (int) ans;
    }

    private long countAtMost(int[] arr, long limit) {
        if (limit < 0)
            return 0;

        int left = 0;
        long sum = 0;
        long count = 0;

        for (int right = 0; right < arr.length; right++) {
            sum += arr[right];

            while (sum > limit) {
                sum -= arr[left];
                left++;
            }

            count += (right - left + 1);
        }

        return count;
    }
}
