///////////                   Split Array into Minimum Subsets                    ///////////////




class Solution {
    public int minSubsets(int[] arr) {
        java.util.Arrays.sort(arr);

        int subsets = 1;

        for (int i = 1; i < arr.length; i++) {
            if (arr[i] != arr[i - 1] + 1) {
                subsets++;
            }
        }

        return subsets;
    }
}
