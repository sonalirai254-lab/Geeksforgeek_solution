/////////////                 Secret Cipher                 //////////////






class Solution {
    public String compress(String s) {
        int n = s.length();

        if (n <= 1) {
            return s;
        }

        int[] lps = new int[n];

        for (int i = 1; i < n; i++) {
            int len = lps[i - 1];

            while (len > 0 && s.charAt(i) != s.charAt(len)) {
                len = lps[len - 1];
            }

            if (s.charAt(i) == s.charAt(len)) {
                len++;
            }

            lps[i] = len;
        }

        StringBuilder rev = new StringBuilder();

        int i = n - 1;

        while (i > 0) {
            int len = i + 1;

            if (len % 2 == 0) {
                int longestPrefixSuffix = lps[i];
                int blockLength = len - longestPrefixSuffix;

                boolean canCompress =
                        longestPrefixSuffix * 2 >= len &&
                        len % blockLength == 0 &&
                        (len / blockLength) % 2 == 0;

                if (canCompress) {
                    rev.append('*');
                    i = len / 2 - 1;
                    continue;
                }
            }

            rev.append(s.charAt(i));
            i--;
        }

        rev.append(s.charAt(0));

        return rev.reverse().toString();
    }
}
