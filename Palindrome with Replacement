////////////////////////////////                      Palindrome with Replacement                     //////////////////////////////////






class Solution {
    public int minimumSum(String s) {
        int n = s.length();
        int prev = -1;
        int sum = 0;

        for (int i = 0; i < n / 2; i++) {
            char a = s.charAt(i);
            char b = s.charAt(n - 1 - i);

            if (a != '?' && b != '?' && a != b) {
                return -1;
            }

            char c = a != '?' ? a : b;

            if (c != '?') {
                if (prev != -1) {
                    sum += 2 * Math.abs(c - prev);
                }
                prev = c;
            }
        }

        return sum;
    }
}
