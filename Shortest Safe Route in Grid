//////////////////////////                      Shortest Safe Route in Grid                      //////////////////////////////







import java.util.*;

class Solution {
    public int shortestPath(int[][] mat) {
        int n = mat.length;
        int m = mat[0].length;

        boolean[][] safe = new boolean[n][m];

        for (int i = 0; i < n; i++) {
            Arrays.fill(safe[i], true);
        }

        int[] dr = {-1, 1, 0, 0};
        int[] dc = {0, 0, -1, 1};

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                if (mat[i][j] == 0) {
                    safe[i][j] = false;

                    for (int k = 0; k < 4; k++) {
                        int nr = i + dr[k];
                        int nc = j + dc[k];

                        if (nr >= 0 && nr < n && nc >= 0 && nc < m) {
                            safe[nr][nc] = false;
                        }
                    }
                }
            }
        }

        Queue<int[]> q = new LinkedList<>();

        for (int i = 0; i < n; i++) {
            if (safe[i][0]) {
                q.offer(new int[]{i, 0, 1});
                safe[i][0] = false;
            }
        }

        while (!q.isEmpty()) {
            int[] curr = q.poll();

            int r = curr[0];
            int c = curr[1];
            int dist = curr[2];

            if (c == m - 1) {
                return dist;
            }

            for (int k = 0; k < 4; k++) {
                int nr = r + dr[k];
                int nc = c + dc[k];

                if (nr >= 0 && nr < n && nc >= 0 && nc < m && safe[nr][nc]) {
                    safe[nr][nc] = false;
                    q.offer(new int[]{nr, nc, dist + 1});
                }
            }
        }

        return -1;
    }
}
