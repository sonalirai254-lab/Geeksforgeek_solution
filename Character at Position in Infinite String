//////////////////////////////                   Character at Position in Infinite String                   //////////////////////////////






class Solution {
    public char posInfinite(String s, long pos) {

        long len = s.length();
        long step = 1;

     
        while (len < pos) {
            len = 2 * len + step;
            step++;
        }

       
        for (long i = step - 1; i >= 1; i--) {

            long prevLen = (len - i) / 2;

            if (pos > prevLen + i) {

               
                pos = len - pos + 1;

            } else if (pos > prevLen) {

            
                return '$';
            }

            len = prevLen;
        }

        return s.charAt((int) pos - 1);
    }
}
