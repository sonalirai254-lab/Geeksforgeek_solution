////////////////////////////////                           Minimum Time with 2 Scanners                             ////////////////////////////////








class Solution {
    public int minTime(int n, int s1, int s2) {

        int low = 0;
        int high = n * Math.min(s1, s2);

        while (low < high) {
            int mid = low + (high - low) / 2;

            long documents = (long) mid / s1 + (long) mid / s2;

            if (documents >= n) {
                high = mid;
            } else {
                low = mid + 1;
            }
        }

        return low;
    }
}
