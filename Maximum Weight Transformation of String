////////////////////////////////                         Maximum Weight Transformation of String                           //////////////////////////////





class Solution {
    public int getMaxWeight(String s) {
        int n = s.length();

        int prev2 = 0;
        int prev1 = 1;

        for (int i = 1; i < n; i++) {
            int single = prev1 + 1;

            int pair;
            if (s.charAt(i - 1) != s.charAt(i)) {
                pair = prev2 + 4;
            } else {
                pair = prev2 + 3;
            }

            int curr = Math.max(single, pair);

            prev2 = prev1;
            prev1 = curr;
        }

        return prev1;
    }
}
