//////////////////////////                     Max Adjacent Diffs Sum with 1 Replacements                      //////////////////////////






class Solution {
    public long maxDiffSum(int[] arr) {
        int n = arr.length;

        if (n <= 1) {
            return 0;
        }

      
        long dpOriginal = 0;
        long dpOne = 0;

        for (int i = 1; i < n; i++) {
         
            long newOriginal = Math.max(
                dpOriginal + Math.abs((long) arr[i] - arr[i - 1]),
                dpOne + Math.abs((long) arr[i] - 1)
            );

           
            long newOne = Math.max(
                dpOriginal + Math.abs(1L - arr[i - 1]),
                dpOne
            );

            dpOriginal = newOriginal;
            dpOne = newOne;
        }

        return Math.max(dpOriginal, dpOne);
    }
}
