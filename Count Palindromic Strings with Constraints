///////////////////////                        Count Palindromic Strings with Constraints                           /////////////////////////





import java.util.*;

class Solution {
    static final long MOD = 1000000007L;

    public int palindromicStrings(int n, int k) {
        long[] fact = new long[k + 1];
        fact[0] = 1;

        for (int i = 1; i <= k; i++) {
            fact[i] = fact[i - 1] * i % MOD;
        }

        long ans = 0;

        for (int len = 1; len <= n; len++) {
            int half = len / 2;

            if (half > k) continue;

            long ways = fact[k] * modInverse(fact[k - half]) % MOD;

            if (len % 2 == 1) {
                ways = ways * (k - half) % MOD;
            }

            ans = (ans + ways) % MOD;
        }

        return (int) ans;
    }

    static long modInverse(long x) {
        return power(x, MOD - 2);
    }

    static long power(long a, long b) {
        long result = 1;

        while (b > 0) {
            if ((b & 1) == 1) {
                result = result * a % MOD;
            }

            a = a * a % MOD;
            b >>= 1;
        }

        return result;
    }
}
