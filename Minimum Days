////////////////////////////////                        Minimum Days                      ////////////////////////////////







class Solution {
    public int getMinimumDays(String S, int[] P) {
        int n = S.length();

        int[] day = new int[n];

        for (int i = 0; i < n; i++) {
            day[P[i]] = i + 1;
        }

        int low = 0, high = n;
        int ans = n;

        while (low <= high) {
            int mid = low + (high - low) / 2;
            boolean valid = true;

            for (int i = 0; i < n - 1; i++) {
                if (S.charAt(i) == S.charAt(i + 1)
                        && day[i] > mid
                        && day[i + 1] > mid) {
                    valid = false;
                    break;
                }
            }

            if (valid) {
                ans = mid;
                high = mid - 1;
            } else {
                low = mid + 1;
            }
        }

        return ans;
    }
}
