//////////////////                   Minimum Moves to Sort Permutation                       /////////////////




class Solution {
    public int minMoves(int[] arr) {
        int n = arr.length;
        int longest = 1;

       
        int[] pos = new int[n + 1];

        for (int i = 0; i < n; i++) {
            pos[arr[i]] = i;
        }

        int current = 1;

        for (int value = 2; value <= n; value++) {
            if (pos[value - 1] < pos[value]) {
                current++;
            } else {
                current = 1;
            }

            longest = Math.max(longest, current);
        }

        return n - longest;
    }
}
